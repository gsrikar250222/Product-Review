# SerpAPI Key for Google Search & Shopping results
SERPAPI_API_KEY=your_serpapi_key_here

# HuggingFace API Key for NLP & sentiment models
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./reviewai.db

# Storage and Cache
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
CACHE_TTL_HOURS=12
